    },
    {
      "_id": "8ytnaN3wj8W9itTr",
      "name": "Habilidade Oculta: Sand Force",
      "type": "feat",
      "img": "icons/magic/control/buff-flight-wings-blue.webp",
      "system": {
        "description": {
          "value": "<p>Durante uma Tempestade de Areia, este Pokémon pode rolar o dado de dano de seus Moves do tipo Terra, Pedra e Aço duas vezes e escolher o maior resultado. Além disso, este Pokémon não receberá dano da Tempestade de Areia se normalmente fosse afetado por ela.</p><p><em>Habilidade Oculta — normalmente inativa, só entra em uso com o item Ability Patch.</em></p>",
          "chat": ""
        },
